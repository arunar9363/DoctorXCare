rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function textBetween(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);
    }
    match /savedDiseases/{uid}/diseases/{disease} {
      allow read, create, update, delete: if isOwner(uid);
    }
    match /assessmentHistory/{uid}/assessments/{assessment} {
      allow read, create, update, delete: if isOwner(uid);
    }
    match /healthTracking/{uid}/readings/{reading} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
          ['metric', 'date', 'context', 'notes', 'value', 'unit', 'systolic', 'diastolic', 'pulse']
        )
        && textBetween(request.resource.data.date, 10, 40)
        && request.resource.data.metric in [
          'blood_pressure', 'blood_glucose', 'heart_rate', 'weight', 'oxygen_saturation', 'tsh', 't3', 't4'
        ]
        && (request.resource.data.metric == 'blood_pressure'
          ? request.resource.data.systolic is number && request.resource.data.systolic > 0
            && request.resource.data.diastolic is number && request.resource.data.diastolic > 0
            && request.resource.data.get('pulse', 1) is number && request.resource.data.get('pulse', 1) > 0
          : request.resource.data.value is number && request.resource.data.value >= 0
            && textBetween(request.resource.data.unit, 1, 24))
        && textBetween(request.resource.data.get('context', ''), 0, 120)
        && textBetween(request.resource.data.get('notes', ''), 0, 500);
    }
    match /publicFeedback/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'type', 'rating', 'createdAt'])
        && textBetween(request.resource.data.name, 1, 100)
        && textBetween(request.resource.data.message, 1, 2000)
        && textBetween(request.resource.data.type, 1, 50)
        && request.resource.data.rating is int && request.resource.data.rating in [1, 2, 3, 4, 5]
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/feedbackSubmissions/$(id));
    }
    match /feedbackSubmissions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'phone', 'createdAt', 'status'])
        && textBetween(request.resource.data.email, 3, 254)
        && textBetween(request.resource.data.phone, 0, 40)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/publicFeedback/$(id));
    }
  }
}
