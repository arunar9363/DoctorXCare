{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "functions": {
    "api/medical.py": {
      "includeFiles": "{doctorx_backend/**,shared/firebase-public.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:service(medical-analysis|python-health|chronic-care|recovery-plan|find-specialist)",
      "destination": "/api/medical"
    },
    {
      "source": "/api/health-tracking/:path*",
      "destination": "/api/medical"
    },
    {
      "source": "/api/v1/nearby-finder",
      "destination": "/api/medical"
    },
    {
      "source": "/api/v1/facility-details/:placeId",
      "destination": "/api/medical"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
